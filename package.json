{
  "name": "requirement-calendar",
  "version": "0.5.4",
  "description": "面向程序员的需求排期日历",
  "author": "11eleve",
  "private": true,
  "main": "desktop/electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "python3 scripts/build.py",
    "predesktop": "node scripts/prepare-windows-cli.cjs",
    "desktop": "electron .",
    "test": "node --test tests/unit/*.test.cjs",
    "test:build": "python3 tests/unit/build.test.py",
    "test:cli": "python3 tests/macos/cli-native.py",
    "pretest:desktop": "node scripts/prepare-windows-cli.cjs",
    "test:desktop": "electron . --calendar-smoke-test",
    "build:mac": "scripts/build-macos.sh",
    "dist:mac": "npm run build:mac && scripts/build-installer-macos.sh && scripts/build-dmg-macos.sh && scripts/verify-dmg-macos.sh",
    "build:cli:win": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/build-cli-windows.ps1",
    "dist:win": "npm run build:cli:win && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.11eleve.requirement-calendar",
    "productName": "需求日历",
    "asar": true,
    "directories": {
      "output": "dist/windows"
    },
    "files": [
      "index.html",
      "desktop/electron/**",
      "src/**",
      "assets/app-icon.png",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "desktop/electron/windows-reminders.ps1",
        "to": "windows-reminders.ps1"
      },
      {
        "from": "desktop/windows/cli/path.ps1",
        "to": "cli/path.ps1"
      }
    ],
    "extraFiles": [
      {
        "from": ".build/windows-cli/reqcal.exe",
        "to": "reqcal.exe"
      }
    ],
    "protocols": [
      {
        "name": "需求日历提醒",
        "schemes": [
          "requirement-calendar"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/app-icon.png",
      "executableName": "RequirementCalendar",
      "artifactName": "RequirementCalendar-${version}-${arch}-Setup.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "需求日历",
      "runAfterFinish": false,
      "include": "desktop/electron/installer.nsh",
      "deleteAppDataOnUninstall": false
    }
  }
}
